# Required: your OpenRouter key (https://openrouter.ai/keys). Also set a credit limit on the key itself.
OPENROUTER_API_KEY=

# Models (any OpenRouter model id with tool support)
MODEL_FAST=anthropic/claude-haiku-5.5
MODEL_SMART=anthropic/claude-sonnet-5.5

# Hard stop for all LLM spend per local day, in USD
DAILY_BUDGET_USD=8

# Probability (0-1) that a tool call fails on purpose, to exercise error paths. 0 disables.
CHAOS_RATE=0

# Schedules (local time, 24h)
WIRE_MORNING_AT=06:00
WIRE_EVENING_AT=18:00
HISTORY_AT=07:00
STUDENT_AT=13:00
RECS_AT=20:00

# macOS notification when the morning brief is ready
NOTIFY=1
